// =============================================
// 個人アーティスト営業プラットフォーム
// Prisma スキーマ定義
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// Enum 定義
// =============================================

enum UserRole {
  GENERAL
  PRO
  ADMIN
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
}

enum ContractType {
  SPOT
  SUBSCRIPTION
}

enum ProjectStatus {
  OPEN
  MATCHING
  CLOSED
  PRIVATE // マッチ済みユーザーにだけ相互紹介できる非公開案件
}

enum MatchStatus {
  APPLIED
  ACCEPTED
  COMPLETED
  REJECTED
}

// =============================================
// モデル定義
// =============================================

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  passwordHash     String?  // Credentials認証時のみ
  role             UserRole @default(GENERAL)
  genres           String[] // PostgreSQL 配列型
  bio              String?
  avatarUrl        String?  // Uploadthing ファイルキー
  coverUrl         String?  // プロフィールカバー画像（ジャケット）
  earlyBirdSlot    Int?     @unique // 創設メンバー枠のスロット番号（1..EARLY_BIRD_TOTAL）。null なら通常ユーザー
  earlyBirdExpiresAt DateTime? // PRO 無料期間の終わり。null なら期限なし（旧・先着 30 名の永久 PRO 組）
  earlyBirdReminderSentAt DateTime? // 無料期間終了の切迫メール送信済みタイムスタンプ（重複送信防止）
  hasPaidSubscription Boolean @default(false) // RevenueCat webhook が維持。true なら失効 cron の対象外
  averageRating    Decimal  @default(0) @db.Decimal(3, 2)
  featuredPortfolioId String? // アーティスト本人が一覧カードのメインに見せる作品
  isGuest          Boolean  @default(false) // テスト用ゲストアカウント（24h で自動削除）
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  portfolios        Portfolio[]
  featuredPortfolio Portfolio?     @relation("FeaturedPortfolio", fields: [featuredPortfolioId], references: [id], onDelete: SetNull)
  projectsAsClient  Project[]      @relation("ClientProjects")
  matchesAsArtist   Match[]        @relation("ArtistMatches")
  matchesAsPartner  Match[]        @relation("PartnerMatches")
  sentMessages      Message[]
  reviewsGiven      Review[]       @relation("ReviewerReviews")
  likesGiven        Like[]         @relation("LikesGiven")
  likesReceived     Like[]         @relation("LikesReceived")
  passwordResetTokens PasswordResetToken[] @relation("PasswordResets")
  emailChangeRequests EmailChangeRequest[] @relation("EmailChanges")
  accounts          Account[]
  sessions          Session[]

  @@index([isGuest, createdAt])
  @@map("users")
}

model Portfolio {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  mediaType   MediaType
  fileKey     String    // Uploadthing ファイルキー
  createdAt   DateTime  @default(now())

  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  featuredByUsers User[] @relation("FeaturedPortfolio")

  @@map("portfolios")
}

model Project {
  id           String        @id @default(cuid())
  clientId     String
  title        String
  description  String?
  genres       String[]
  budget       Int?          // 円単位
  contractType ContractType
  status       ProjectStatus @default(OPEN)
  createdAt    DateTime      @default(now())

  client  User    @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  matches Match[]

  @@map("projects")
}

model Match {
  id            String      @id @default(cuid())
  projectId     String?     // P2P マッチでは null
  artistId      String      // Project 応募の場合: 受注アーティスト / P2P の場合: いいねを先に出した側
  partnerUserId String?     // P2P マッチでの相手。projectId が null のとき必須
  status        MatchStatus @default(APPLIED)
  message       String?     // 応募メッセージ
  createdAt     DateTime    @default(now())

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artist   User      @relation("ArtistMatches", fields: [artistId], references: [id], onDelete: Cascade)
  partner  User?     @relation("PartnerMatches", fields: [partnerUserId], references: [id], onDelete: Cascade)
  messages Message[]
  reviews  Review[]

  @@unique([projectId, artistId])   // 同一プロジェクトへの重複応募防止（PostgreSQL の NULL は重複扱いされない）
  @@unique([artistId, partnerUserId]) // 同じ P2P ペアで重複マッチを作らない
  @@map("matches")
}

model Like {
  id        String   @id @default(cuid())
  likerId   String   // 「いいね」を付けた人
  likedId   String   // 「いいね」された人
  createdAt DateTime @default(now())

  liker User @relation("LikesGiven", fields: [likerId], references: [id], onDelete: Cascade)
  liked User @relation("LikesReceived", fields: [likedId], references: [id], onDelete: Cascade)

  @@unique([likerId, likedId])
  @@index([likedId])
  @@map("likes")
}

// パスワードリセット用ワンタイムトークン
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // 平文トークンの SHA-256 ハッシュ
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("PasswordResets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// メールアドレス変更用ワンタイムトークン（新メアドに送って確認させる）
model EmailChangeRequest {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("EmailChanges", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_requests")
}

model Message {
  id        String    @id @default(cuid())
  matchId   String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Review {
  id         String   @id @default(cuid())
  matchId    String
  reviewerId String
  score      Int      @db.SmallInt // 1〜5
  comment    String?
  createdAt  DateTime @default(now())

  match    Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reviewer User  @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([matchId, reviewerId]) // 1案件1レビュー
  @@map("reviews")
}

// =============================================
// NextAuth.js v5 Prisma Adapter 用テーブル
// =============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
