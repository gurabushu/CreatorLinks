# =============================================
# 個人アーティスト営業プラットフォーム
# 環境変数テンプレート
# =============================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/creator_links_dev"

# --- NextAuth.js v5 ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# OAuth プロバイダー
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- RevenueCat Web Billing ---
# RevenueCat ダッシュボード: https://app.revenuecat.com
#   1. プロジェクトを作成し、Web Billing (旧 RevenueCat Billing) を有効化
#   2. Public API Key を取得（フロントエンド SDK 用、公開されて OK）
#   3. Entitlement を作成: 識別子 = "pro" (デフォルト。変えるなら NEXT_PUBLIC_REVENUECAT_PRO_ENTITLEMENT_ID で上書き)
#   4. Offering + Package を作り、そこに月額 ¥980 の Product を紐づけ
#   5. Integrations → Webhooks で本番 URL を登録し、HMAC 署名を有効化。ここで表示される Signing Secret を REVENUECAT_WEBHOOK_SIGNING_SECRET に。
NEXT_PUBLIC_REVENUECAT_WEB_BILLING_PUBLIC_API_KEY="rcb_..."
NEXT_PUBLIC_REVENUECAT_PRO_ENTITLEMENT_ID="pro"
NEXT_PUBLIC_REVENUECAT_PRO_OFFERING_ID="default" # 空にすると current offering を使う
REVENUECAT_WEBHOOK_SIGNING_SECRET="whsec_..." # RevenueCat ダッシュボードで発行される HMAC 用シークレット

# --- Stripe Connect (依頼主 → アーティスト報酬決済 / Express + Separate Charges & Transfers) ---
# Stripe ダッシュボード: https://dashboard.stripe.com
#   1. 日本のアカウントを有効化し、Connect を有効化（Settings → Connect → Get Started）
#   2. アカウントタイプは "Express" を選択（Stripe が KYC を負担）
#   3. API keys の "Secret key" を STRIPE_SECRET_KEY に、"Publishable key" を NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY に
#   4. Webhooks 設定で本番 URL (/api/stripe/webhook) を登録し、Signing secret を STRIPE_WEBHOOK_SECRET に
#      監視イベント: payment_intent.succeeded / payment_intent.payment_failed / account.updated /
#                   transfer.created / transfer.failed / charge.refunded
#   5. Local 開発時は `stripe listen --forward-to localhost:3000/api/stripe/webhook` で
#      発行される whsec_... を STRIPE_WEBHOOK_SECRET に入れる
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Pusher (リアルタイム) ---
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="ap3"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap3"

# --- Resend (メール) ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@creatorlinks.jp"

# --- Inngest (ジョブキュー) ---
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="signkey-..."

# --- Upstash Redis (レートリミット) ---
# Vercel Marketplace → Storage → Upstash for Redis で 1 クリック作成。
# 未設定時は checkRateLimit がスキップされる（ローカル開発用のフェイルオープン）。
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AY...="

# --- Sentry (エラー監視) ---
SENTRY_DSN="https://..."
NEXT_PUBLIC_SENTRY_DSN="https://..."

# --- App URL ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
