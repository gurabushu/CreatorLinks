# =============================================
# 個人アーティスト営業プラットフォーム
# 環境変数テンプレート
# =============================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/creator_links_dev"

# --- NextAuth.js v5 ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# OAuth プロバイダー
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- RevenueCat Web Billing ---
# RevenueCat ダッシュボード: https://app.revenuecat.com
#   1. プロジェクトを作成し、Web Billing (旧 RevenueCat Billing) を有効化
#   2. Public API Key を取得（フロントエンド SDK 用、公開されて OK）
#   3. Entitlement を作成: 識別子 = "pro" (デフォルト。変えるなら NEXT_PUBLIC_REVENUECAT_PRO_ENTITLEMENT_ID で上書き)
#   4. Offering + Package を作り、そこに月額 ¥980 の Product を紐づけ
#   5. Integrations → Webhooks で本番 URL を登録し、HMAC 署名を有効化。ここで表示される Signing Secret を REVENUECAT_WEBHOOK_SIGNING_SECRET に。
NEXT_PUBLIC_REVENUECAT_WEB_BILLING_PUBLIC_API_KEY="rcb_..."
NEXT_PUBLIC_REVENUECAT_PRO_ENTITLEMENT_ID="pro"
NEXT_PUBLIC_REVENUECAT_PRO_OFFERING_ID="default" # 空にすると current offering を使う
REVENUECAT_WEBHOOK_SIGNING_SECRET="whsec_..." # RevenueCat ダッシュボードで発行される HMAC 用シークレット

# --- Uploadthing ---
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-app-id"

# --- Pusher (リアルタイム) ---
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="ap3"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap3"

# --- Resend (メール) ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@creatorlinks.jp"

# --- Inngest (ジョブキュー) ---
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="signkey-..."

# --- Sentry (エラー監視) ---
SENTRY_DSN="https://..."
NEXT_PUBLIC_SENTRY_DSN="https://..."

# --- App URL ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
